generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode String     @unique @map("country_code")
  slug        String     @unique
  title       String
  imageJson   Json?      @map("image_json")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")
  operators   Operator[]

  @@map("countries")
}

model Operator {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country              Country   @relation(fields: [countryId], references: [id], onDelete: Restrict)
  countryId            String    @map("country_id") @db.Uuid
  airaloOperatorId     Int?      @map("airalo_operator_id")
  activationPolicy     String?   @map("activation_policy")
  apn                  Json?     @map("apn")
  apnType              String?   @map("apn_type")
  apnValue             String?   @map("apn_value")
  countriesJson        Json?     @map("countries_json")
  coveragesJson        Json?     @map("coverages_json")
  esimType             String?   @map("esim_type")
  gradientEnd          String?   @map("gradient_end")
  gradientStart        String?   @map("gradient_start")
  imageJson            Json?     @map("image_json")
  info                 String[]  @db.Text
  installWindowDays    Int?      @map("install_window_days")
  isKycVerify          Boolean?  @map("is_kyc_verify")
  isPrepaid            Boolean?  @map("is_prepaid")
  isRoaming            Boolean?  @map("is_roaming")
  otherInfo            String?   @map("other_info")
  planType             String?   @map("plan_type")
  rechargeability      Boolean?  @map("rechargeability")
  style                String?
  title                String
  topupGraceWindowDays Int?      @map("topup_grace_window_days")
  type                 String?
  warning              Json?     @map("warning")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  packages             Package[]

  @@index([countryId])
  @@map("operators")
}

model Package {
  id                           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operator                     Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatorId                   String            @map("operator_id") @db.Uuid
  airaloPackageId              String            @unique @map("airalo_package_id")
  type                         String
  title                        String
  amount                       Int
  data                         String
  day                          Int
  isUnlimited                  Boolean           @default(false) @map("is_unlimited")
  manualInstallation           String            @map("manual_installation")
  qrInstallation               String            @map("qr_installation")
  isFairUsagePolicy            Boolean?          @map("is_fair_usage_policy")
  fairUsagePolicy              String?           @map("fair_usage_policy")
  netPrice                     Decimal?          @map("net_price") @db.Decimal(12, 4)
  price                        Decimal           @db.Decimal(12, 4)
  pricesNetPrice               Json?             @map("prices_net_price")
  pricesRecommendedRetailPrice Json?             @map("prices_recommended_retail_price")
  shortInfo                    String?           @map("short_info")
  text                         Int?
  voice                        Int?
  createdAt                    DateTime          @default(now()) @map("created_at")
  updatedAt                    DateTime          @default(now()) @updatedAt @map("updated_at")
  state                        PackageState?
  esimOrders                   EsimOrder[]
  checkoutSessions             CheckoutSession[]

  @@index([operatorId])
  @@map("packages")
}

model PackageState {
  package            Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId          String    @id @map("package_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  deactivatedAt      DateTime? @map("deactivated_at")
  basePriceCents     Int       @default(0) @map("base_price_cents")
  sellingPriceCents  Int?      @map("selling_price_cents")
  currencyCode       String    @default("USD") @map("currency_code")
  sourcePriceDecimal Decimal?  @map("source_price_decimal") @db.Decimal(12, 4)
  sellPriceDecimal   Decimal?  @map("sell_price_decimal") @db.Decimal(12, 4)
  lastSyncedAt       DateTime? @map("last_synced_at")
  sourceHash         String?   @map("source_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([lastSyncedAt])
  @@map("package_state")
}

model SyncRun {
  id            String            @id @default(cuid())
  startedAt     DateTime          @default(now()) @map("started_at")
  finishedAt    DateTime?         @map("finished_at")
  status        String
  source        String            @default("airalo")
  triggeredBy   String            @default("system") @map("triggered_by")
  version       String?
  notes         String?
  errorSummary  String?           @map("error_summary")
  insertedCount Int               @default(0) @map("inserted_count")
  updatedCount  Int               @default(0) @map("updated_count")
  skippedCount  Int               @default(0) @map("skipped_count")
  warningCount  Int               @default(0) @map("warning_count")
  failureCount  Int               @default(0) @map("failure_count")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  items         SyncRunItem[]
  snapshots     EntitySnapshot[]
  packagePages  PackageSyncPage[]

  @@index([startedAt])
  @@index([status])
  @@map("sync_runs")
}

model PackageSyncPage {
  id             String   @id @default(cuid())
  run            SyncRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId          String   @map("run_id")
  page           Int
  limit          Int
  linksJson      Json?    @map("links_json")
  metaJson       Json?    @map("meta_json")
  pricingJson    Json?    @map("pricing_json")
  rawPayloadJson Json?    @map("raw_payload_json")
  countryCount   Int      @map("country_count")
  capturedAt     DateTime @default(now()) @map("captured_at")

  @@unique([runId, page])
  @@index([capturedAt])
  @@map("package_sync_pages")
}

model SyncRunItem {
  id           String   @id @default(cuid())
  run          SyncRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId        String   @map("run_id")
  entityType   String   @map("entity_type")
  entityKey    String   @map("entity_key")
  action       String
  beforeHash   String?  @map("before_hash")
  afterHash    String?  @map("after_hash")
  diffJson     Json?    @map("diff_json")
  warningFlags String[] @default([]) @map("warning_flags")
  errorText    String?  @map("error_text")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([runId, entityType, entityKey])
  @@index([runId, entityType])
  @@index([entityType, entityKey])
  @@map("sync_run_items")
}

model EntitySnapshot {
  id             String   @id @default(cuid())
  run            SyncRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId          String   @map("run_id")
  entityType     String   @map("entity_type")
  entityKey      String   @map("entity_key")
  rawPayloadJson Json     @map("raw_payload_json")
  normalizedJson Json     @map("normalized_json")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([runId, entityType])
  @@index([entityType, entityKey, createdAt])
  @@map("entity_snapshots")
}

model EsimOrder {
  id                   String                     @id @default(cuid())
  orderNumber          String?                    @unique
  requestId            String?                    @unique
  user                 User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId               String?
  ownershipReviewRequired Boolean                 @default(false)
  accessVersion        Int                        @default(0)
  package              Package                    @relation(fields: [packageId], references: [id])
  packageId            String                     @db.Uuid
  status               String                     @default("pending")
  customerEmail        String?
  quantity             Int                        @default(1)
  totalCents           Int?
  currency             String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  profiles             EsimProfile[]
  usageSnapshots       UsageSnapshot[]
  webhookEvents        WebhookEvent[]
  installation         EsimInstallationPayload?
  payment              PaymentTransaction?        @relation(fields: [paymentTransactionId], references: [id])
  paymentTransactionId String?
  checkout             CheckoutSession?
  receiptEmail         String?                    @map("receipt_email")
  receiptSentAt        DateTime?                  @map("receipt_sent_at")
  recoveryAttempts     EsimOrderRecoveryAttempt[]
  airaloSnapshots      AiraloOrderSnapshot[]
  fulfilledAt          DateTime?
  affiliateCommission  AffiliateCommission?
  receiptDeliveries    ReceiptDelivery[]

  @@index([packageId])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model EsimProfile {
  id             String          @id @default(cuid())
  iccid          String          @unique
  imsi           String?
  activationCode String?
  status         String
  order          EsimOrder       @relation(fields: [orderId], references: [id])
  orderId        String
  expiresAt      DateTime?
  activatedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  usageSnapshots UsageSnapshot[]

  @@index([orderId])
}

model UsageSnapshot {
  id                    String      @id @default(cuid())
  profile               EsimProfile @relation(fields: [profileId], references: [id])
  profileId             String
  order                 EsimOrder   @relation(fields: [orderId], references: [id])
  orderId               String
  usedMb                Float?
  remainingMb           Float?
  totalMb               Float?
  status                String?
  expiredAt             DateTime?
  isUnlimited           Boolean?
  remainingVoiceMinutes Int?
  totalVoiceMinutes     Int?
  remainingTextMessages Int?
  totalTextMessages     Int?
  rawPayload            Json?
  recordedAt            DateTime    @default(now())
}

model WebhookEvent {
  id          String     @id @default(cuid())
  eventId     String     @unique
  eventType   String
  order       EsimOrder? @relation(fields: [orderId], references: [id])
  orderId     String?
  /// Raw JSON payload returned by the upstream webhook.
  ///
  /// Stored as a string because the SQLite connector used in development
  /// does not support the Prisma `Json` type.
  payload     String
  createdAt   DateTime   @default(now())
  processedAt DateTime?
}

model AiraloOrderSnapshot {
  id             String     @id @default(cuid())
  order          EsimOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?    @map("order_id")
  source         String
  requestId      String?    @map("request_id")
  orderNumber    String?    @map("order_number")
  rawPayloadJson Json       @map("raw_payload_json")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([orderId])
  @@index([requestId])
  @@index([orderNumber])
  @@index([source, createdAt])
  @@map("airalo_order_snapshots")
}

model EsimOrderRecoveryAttempt {
  id         String    @id @default(cuid())
  order      EsimOrder @relation(fields: [orderId], references: [id])
  orderId    String
  identifier String
  result     String
  reason     String?
  createdAt  DateTime  @default(now())

  @@index([orderId, createdAt])
}

model EsimInstallationPayload {
  id        String    @id @default(cuid())
  order     EsimOrder @relation(fields: [orderId], references: [id])
  orderId   String    @unique
  payload   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CheckoutSession {
  id              String               @id @default(cuid())
  quoteId         String?              @unique
  quote           CheckoutQuote?       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  ownershipReviewRequired Boolean @default(false)
  accessVersion   Int @default(0)
  package         Package              @relation(fields: [packageId], references: [id])
  packageId       String               @db.Uuid
  customerEmail   String?
  quantity        Int                  @default(1)
  totalCents      Int
  currency        String
  status          String               @default("pending")
  intent          String               @default("purchase")
  topUpForOrderId String?
  topUpForIccid   String?
  order            EsimOrder?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId         String?              @unique
  metadata        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  payments        PaymentTransaction[]
  affiliate       AffiliateProfile? @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  affiliateId     String?
  affiliateCode   String?
  affiliateRateBps Int?
  affiliateSource String?
  affiliateCheckedAt DateTime?
  affiliateCommission AffiliateCommission?
  affiliateAdjustments AffiliateSaleAdjustment[]

  @@index([packageId])
  @@index([affiliateId, createdAt])
}

model CheckoutQuote {
  id                 String @id @default(cuid())
  userId             String?
  user               User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestSessionHash   String?
  packageId          String @db.Uuid
  quantity           Int @default(1)
  intent             String
  topUpForOrderId    String?
  topUpForIccid      String?
  displayCents       Int
  displayCurrency    String
  sourceZarCents     Int
  totalCents         Int
  currency           String @default("NAD")
  catalogSnapshot    String
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  checkout           CheckoutSession?

  @@index([expiresAt])
  @@index([userId])
}

enum DpoMode {
  test
  live
}

model DpoSettings {
  id         String   @id @default("dpo")
  activeMode DpoMode  @default(test)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PaymentTransaction {
  id                String                    @id @default(cuid())
  user              User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  ownershipReviewRequired Boolean @default(false)
  provider          String
  dpoMode           DpoMode?
  providerReference String?
  transactionToken  String?
  redirectUrl       String?
  status            String                    @default("pending")
  providerCode      String?
  providerExplanation String?
  version           Int                       @default(0)
  approvedAt        DateTime?
  amountCents       Int
  currency          String
  statusHistory     String?
  metadata          String?
  checkout          CheckoutSession?          @relation(fields: [checkoutId], references: [id])
  checkoutId        String?
  orders            EsimOrder[]
  webhookEvents     PaymentTransactionEvent[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([checkoutId, createdAt])
  @@index([transactionToken])
  @@index([providerReference])
  @@index([status, updatedAt])
}

model PaymentTransactionEvent {
  id            String             @id @default(cuid())
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id])
  transactionId String
  eventType     String
  payload       String
  fromStatus    String?
  toStatus      String?
  transitionVersion Int?
  receivedAt    DateTime           @default(now())

  @@unique([transactionId, transitionVersion])
}

model AiraloAccessToken {
  key       String   @id
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model SyncJob {
  id               String    @id @default(cuid())
  status           String    @default("pending")
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  itemsCreated     Int       @default(0)
  itemsUpdated     Int       @default(0)
  itemsDeactivated Int       @default(0)
  diffPreview      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model User {
  id           String               @id @default(cuid())
  preferredCurrency String?
  email        String               @unique
  name         String?
  phone        String?
  passwordHash String?              @map("password_hash")
  emailVerifiedAt DateTime?         @map("email_verified_at")
  emailProofAt DateTime?
  emailProofSource String?
  authVersion Int @default(0)
  recoveryRequired Boolean @default(false)
  passwordResetRequired Boolean @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  checkouts    CheckoutSession[]
  orders       EsimOrder[]
  payments     PaymentTransaction[]
  identities   UserIdentity[]
  checkoutQuotes CheckoutQuote[]
  affiliate    AffiliateProfile?
}

model AffiliateProgramSettings {
  id             String   @id @default("program")
  enabled        Boolean  @default(false)
  defaultRateBps Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AffiliateProfile {
  id              String @id @default(cuid())
  userId          String @unique
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  code            String @unique
  legalName       String
  publicName      String
  country         String
  contactEmail    String
  phone           String
  businessName    String?
  promotion       String
  status          String @default("pending")
  rateOverrideBps Int?
  termsVersion    String
  termsAcceptedAt DateTime @default(now())
  statusReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  checkouts       CheckoutSession[]
  commissions     AffiliateCommission[]
  ledger          AffiliateLedgerEntry[]
  payouts         AffiliatePayout[]
  notifications   AffiliateNotification[]
}

model AffiliateCommission {
  id                String @id @default(cuid())
  checkoutId        String @unique
  checkout          CheckoutSession @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  orderId           String @unique
  order             EsimOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  affiliateId       String
  affiliate         AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  currency          String
  saleCents         Int
  rateBps           Int
  commissionCents   Int
  refundedSaleCents Int @default(0)
  onHold            Boolean @default(false)
  holdReason        String?
  fulfilledAt       DateTime
  availableAt       DateTime
  createdAt         DateTime @default(now())
  ledger            AffiliateLedgerEntry[]

  @@index([affiliateId, availableAt])
}

model AffiliateLedgerEntry {
  id             String @id @default(cuid())
  affiliateId    String
  affiliate      AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  commissionId   String
  commission     AffiliateCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  kind           String
  amountCents    Int
  currency       String
  availableAt    DateTime
  reason         String?
  reference      String?
  saleRefundCents Int @default(0)
  adjustmentId   String? @unique
  adjustment     AffiliateSaleAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  idempotencyKey String @unique
  createdAt      DateTime @default(now())
  allocations    AffiliatePayoutAllocation[]

  @@index([affiliateId, currency, availableAt])
}

model AffiliateSaleAdjustment {
  id              String @id @default(cuid())
  checkoutId      String
  checkout        CheckoutSession @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  saleRefundCents Int
  reference       String
  reason          String
  actorEmail      String
  idempotencyKey  String @unique
  createdAt       DateTime @default(now())
  ledgerEntry     AffiliateLedgerEntry?

  @@index([checkoutId, createdAt])
}

model AffiliatePayout {
  id                     String @id @default(cuid())
  affiliateId            String
  affiliate              AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  currency               String
  amountCents            Int
  status                 String @default("prepared")
  period                 String
  note                   String?
  preparedBy             String
  transferReference      String?
  paidAt                 DateTime?
  transferAmount         Decimal? @db.Decimal(20, 6)
  transferCurrency       String?
  exchangeRate           Decimal? @db.Decimal(20, 10)
  fees                   Decimal? @db.Decimal(20, 6)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  allocations            AffiliatePayoutAllocation[]

  @@index([affiliateId, createdAt])
}

model AffiliatePayoutAllocation {
  id            String @id @default(cuid())
  payoutId      String
  payout        AffiliatePayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  ledgerEntryId String
  ledgerEntry   AffiliateLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  releasedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([ledgerEntryId])
  @@index([payoutId])
}

model AffiliateNotification {
  id             String @id @default(cuid())
  affiliateId    String
  affiliate      AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  idempotencyKey String @unique
  recipient      String
  subject        String
  text           String
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now())
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([sentAt, nextAttemptAt])
}

model UserIdentity {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  type           String   @default("oauth")
  email          String?
  accessToken    String?
  refreshToken   String?
  expiresAt      Int?
  idToken        String?
  scope          String?
  tokenType      String?
  sessionState   String?
  quarantined    Boolean @default(false)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, providerUserId])
}

model LifecycleJob {
  id String @id @default(cuid())
  businessKey String @unique
  kind String
  targetId String
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

model ReceiptDelivery {
  id String @id @default(cuid())
  businessKey String @unique
  orderId String
  order EsimOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  templateVersion Int @default(1)
  status String @default("pending")
  payload Json?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  firstAttemptAt DateTime?
  acceptanceUnknown Boolean @default(false)
  providerMessageId String?
  acceptedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model AuditLog {
  id         String     @id @default(cuid())
  actor      AdminUser? @relation(fields: [actorId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime   @default(now())
}
