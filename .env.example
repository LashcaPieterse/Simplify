# Public app URL and customer auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical server-side URL used by NextAuth to build OAuth callbacks.
# Production: https://sim.africa (no path or trailing slash)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ORDER_ACCESS_SECRET=
RATE_LIMIT_SECRET=
# Vercel's sanitized x-forwarded-for is selected automatically on Vercel.
# Other deployments must strip/set this header at trusted ingress before configuring it.
TRUSTED_CLIENT_IP_HEADER=
# Activate independently after migrations, staging verification, and scheduler checks.
PURCHASE_LIFECYCLE_ENABLED=false
RECEIPT_OUTBOX_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Enables Resend-backed magic-link sign-in when RESEND_API_KEY is also set.
EMAIL_FROM=

# Airalo catalog sync
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=
AIRALO_BASE_URL=https://partners-api.airalo.com/v2
AIRALO_PACKAGES_SEND_CREDENTIALS=false
AIRALO_BRAND_SETTINGS_NAME=
AIRALO_SYNC_CRON_TOKEN=
AIRALO_SYNC_ALERT_EMAIL=
# Optional override. Async order submissions append ?airalo_webhook_secret=...
# for SIM.Africa webhook authentication.
AIRALO_ASYNC_WEBHOOK_URL=
# Required for async orders. SIM.Africa-owned URL token for Airalo webhook
# callbacks. Prefer a URL-safe random value and keep it separate from
# ORDER_ACCESS_SECRET.
AIRALO_WEBHOOK_SECRET=
AIRALO_RECOVERY_STALE_MINUTES=10
AIRALO_RECOVERY_ALERT_AFTER_MINUTES=45
AIRALO_RECOVERY_BATCH_SIZE=25
AIRALO_SMOKE_ICCID=
# Storefront hides package prices older than this successful sync age.
CATALOG_MAX_AGE_HOURS=48

# DPO payments
# Company ID maps to COMPANY_TOKEN; Service ID maps to SERVICE_TYPE.
DPO_TEST_COMPANY_TOKEN=
DPO_TEST_SERVICE_TYPE=
DPO_LIVE_COMPANY_TOKEN=
DPO_LIVE_SERVICE_TYPE=
# Legacy test-only fallback, used when both DPO_TEST_* values are empty.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_SERVICE_URL=https://secure.3gdirectpay.com/API/v6
DPO_PAYMENT_URL=https://secure.3gdirectpay.com
DPO_IPN_SECRET=

# Email delivery and alerts
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@sim.africa
RECEIPT_EMAIL_FROM=receipts@sim.africa
BUSINESS_EMAIL_FROM=business@sim.africa
BUSINESS_LEADS_EMAIL=

# Tour guide affiliates: deploy the migration before enabling infrastructure.
# Applications/referrals stay closed until enabled separately in Admin → Affiliates.
AFFILIATE_PROGRAM_ENABLED=false
AFFILIATE_REFERRAL_SECRET=
AFFILIATE_EMAIL_FROM=partners@sim.africa
AFFILIATE_APPLICATIONS_EMAIL=

# Optional public WhatsApp support number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Admin authentication
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_ALLOWED_EMAILS=

# Observability
METRICS_BEARER_TOKEN=

# Database
DATABASE_URL=
# Optional Prisma pool tuning for serverless/session-pooled Postgres
PRISMA_CONNECTION_LIMIT=1
PRISMA_POOL_TIMEOUT=20

# Admin financial capabilities: enable individually only after provider validation.
ADMIN_CAPTURE_ENABLED=false
ADMIN_REFUNDS_ENABLED=false
ADMIN_REPLACEMENTS_ENABLED=false
ADMIN_SUPPLIER_REFUNDS_ENABLED=false
