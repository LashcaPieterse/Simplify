{
  "name": "sim-africa",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "postinstall": "prisma generate",
    "airalo:test": "tsx --test lib/airalo/*.test.ts lib/orders/*.test.ts lib/payments/*.test.ts lib/auth/*.test.ts",
    "test": "tsx --test lib/*.test.ts lib/**/*.test.ts",
    "airalo:recover-orders": "tsx scripts/recover-airalo-orders.ts",
    "checkouts:recover-paid": "tsx scripts/recover-paid-checkouts.ts",
    "sanity:seed-trip-destinations": "tsx scripts/seed-trip-destinations.ts",
    "airalo:smoke-live": "tsx scripts/airalo-live-smoke.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@portabletext/react": "^3.0.19",
    "@prisma/client": "^5.10.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^1.0.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "groq": "^3.43.2",
    "lucide-react": "^1.33.0",
    "next": "^16.3.8",
    "next-auth": "^4.24.13",
    "prom-client": "^15.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "^5.31.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-storybook": "^10.6.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "latest",
    "postcss": "^8.5.23",
    "prisma": "^5.10.2",
    "sanity": "^5.31.2",
    "storybook": "^10.6.0",
    "styled-components": "^6.1.19",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "10.1.2"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
